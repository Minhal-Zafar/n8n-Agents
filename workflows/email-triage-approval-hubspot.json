{
  "name": "AI Email Triage with Approval and HubSpot (production)",
  "nodes": [
    {
      "parameters": {
        "inputText": "=Classify the following email into one of the categories below:\n\nCategories:\n1. Interested\n2. Not Interested\n3. Request for Information\n4. Out of Office\n5. Warm Lead – Follow Up Later\n6. Wrong Contact\n7. Bounce / Auto-response / Unintelligible\n\nEmail Subject: {{ $json.subject }}\nEmail Body: {{ $('Email Trigger (IMAP)').item.json.textPlain }}\n\nreturn the category name, name of the person\n",
        "categories": {
          "categories": [
            {
              "category": "Request for Information",
              "description": "Choose this when the email asks for additional details such as pricing, case studies, timelines, feature specs, or onboarding process, but does not yet commit."
            },
            {
              "category": "Interested",
              "description": "Select this when the email clearly expresses interest in learning more, scheduling a meeting, receiving a proposal, or exploring a partnership."
            },
            {
              "category": "Not Interested",
              "description": "Use this category when the recipient explicitly declines the offer or expresses no interest in engaging further."
            },
            {
              "category": "Out of Office",
              "description": "Select this when the response is an automated or manual out-of-office notification indicating delayed availability."
            },
            {
              "category": "Warm Lead – Follow Up Later",
              "description": "Use this category when the email shows mild interest, such as a deferment to a later time (“get back to me next month” / “circle back in Q4”).  Someone who does not reject us, keeps the door open for the future, or provides helpful details about their work (e.g., locations, types of projects, referral offers) without showing urgent need. Often says they will keep our contact on file."
            },
            {
              "category": "Wrong Contact",
              "description": "Choose this when the recipient states that they are not the right person to talk to and might refer someone else or ask you not to contact again."
            },
            {
              "category": "Bounce / Auto-response / Unintelligible",
              "description": "Use this category for hard bounces, auto-replies with no meaningful content, or emails that are blank/gibberish."
            },
            {
              "category": "MQL",
              "description": "A lead who has a clear, immediate project or requirement and is asking for pricing, timelines, meetings, demo or other details to proceed. This includes people who specifically request a proposal, quote, rate sheet, or want to start a conversation about a current project."
            }
          ]
        },
        "options": {}
      },
