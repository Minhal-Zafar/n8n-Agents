    {
      "parameters": {
        "jsCode": "const hubspotEmail = $json.properties?.email;\nconst contactName = $json.properties?.firstname || \"Unknown\";\nconst theirEmail = $('Email Trigger (IMAP)').first().json.textPlain || \"\";\nconst ourReply = \"We replied with a thank you message and a Calendly link to schedule a call.\"; // dynamic later\n\n// From previous node (parsed email + name)\nconst aiEmail = $json.aiEmail;\nconst aiName = $json.aiName;\n\n// Logic\nif (hubspotEmail && aiEmail && hubspotEmail.toLowerCase() === aiEmail.toLowerCase()) {\n  // Contact exists → update\n  return [\n    {\n      json: {\n        email: hubspotEmail,\n        name: contactName,\n        _action: \"update\",\n        summary: {\n          their_email: theirEmail,\n          our_reply: ourReply\n        }\n      }\n    }\n  ];\n} else {\n  // New contact → create\n  return [\n    {\n      json: {\n        email: aiEmail,\n        name: aiName,\n        _action: \"create\",\n        summary: {\n          their_email: theirEmail,\n          our_reply: ourReply\n        }\n      }\n    }\n  ];\n}"
      },
