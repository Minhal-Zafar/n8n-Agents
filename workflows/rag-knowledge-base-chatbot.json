      },
      "id": "bfa62895-c189-5632-9067-4b61214e0269",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        280.0,
        560
      ]
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "company_docs",
        "toolDescription": "Search the company's internal documents (policies, product docs, FAQs). Input: a search query.",
        "qdrantCollection": {
