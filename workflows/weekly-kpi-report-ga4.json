      "id": "a128af29-3081-522b-b989-d3c9df215ec2",
      "name": "GA4: previous 7 days",
      "type": "n8n-nodes-base.googleAnalytics",
      "typeVersion": 2,
      "executeOnce": true,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// GA4 raw rows: metricValues[i].value in the order requested above.\nconst names = ['activeUsers', 'sessions', 'screenPageViews', 'keyEvents'];\nconst total = items => names.map((_, i) => items.reduce((a, it) => a + Number(it.json.rows?.[0]?.metricValues?.[i]?.value ?? it.json.metricValues?.[i]?.value ?? 0), 0));\nconst cur = total($('GA4: last 7 days').all()), prev = total($input.all());\nconst kpis = names.map((n, i) => ({ metric: n, this_week: cur[i], last_week: prev[i],\n  change_pct: prev[i] ? Math.round((cur[i] - prev[i]) / prev[i] * 1000) / 10 : null }));\nconst table = kpis.map(k => `<tr><td>${k.metric}</td><td>${k.this_week}</td><td>${k.last_week}</td><td>${k.change_pct ?? '-'}%</td></tr>`).join('');\nreturn [{ json: { kpis, html_table: `<table border=1 cellpadding=6><tr><th>Metric</th><th>This week</th><th>Last week</th><th>Change</th></tr>${table}</table>` } }];"
      },
      "id": "e8ab0c30-345b-5a3e-8eb1-37efb7db295d",
      "name": "Compare week over week",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        0
      ]
    },
